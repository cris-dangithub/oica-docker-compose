# Los valores por defecto de Compose son exclusivos para desarrollo.
COMPOSE_PROJECT_NAME=oica
POSTGRES_DB=oica_db
POSTGRES_USER=oica_user
# Producción: generar valores hexadecimales con openssl rand -hex 32.
POSTGRES_PASSWORD=oica_local_password
SECRET_KEY=solo-desarrollo-cambiar-en-produccion
ALLOWED_ORIGINS=http://localhost
HTTP_PORT=80
WORKER_CONCURRENCY=1
# container: Nginx de Compose (predeterminado); host: Nginx externo ya configurado.
# Usar bash scripts/compose.sh up -d --wait para aplicar este selector en local.
OICA_PROXY_MODE=container
OICA_FRONTEND_PORT=13000
OICA_BACKEND_PORT=15000
# En VPS: origen público real, usado en la comprobación final del despliegue host.
OICA_PUBLIC_URL=https://oica.cris-munoz.me
